# Copy this file to .env.deploy before deployment. Never commit real keys.

# LLM gateway
OPENAI_API_KEY1=replace-with-your-api-key
OPENAI_BASE_URL=https://your-llm-gateway.example.com/v1
CHAT_MODEL=replace-with-chat-model
INTENT_MODEL=replace-with-small-intent-model

# Web search
SERPER_API_KEY1=replace-with-your-serper-api-key

# RAG
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_LOCAL_FILES_ONLY=false
RAG_SCORE_THRESHOLD=0.7
RAG_TOP_K=5
INTENT_CONFIDENCE_THRESHOLD=0.6
DOCUMENT_CHUNK_SIZE=500
DOCUMENT_CHUNK_OVERLAP=50

# Internal service authentication
INTERNAL_SKILL_API_KEY=replace-with-a-long-random-value

# Public ports
HTTP_PORT=80

# Optional analytics console controls
ANALYTICS_VIEW_PATH=/api/analytics/admin
ANALYTICS_WHITELIST_CLIENT_IDS=
