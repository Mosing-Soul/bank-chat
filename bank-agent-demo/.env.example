# LLM API
OPENAI_API_KEY1=replace-with-your-api-key
OPENAI_BASE_URL=https://your-llm-gateway.example.com/v1
CHAT_MODEL=replace-with-chat-model

# Embedding / RAG
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_LOCAL_FILES_ONLY=true
BANK_DOCS_FOLDER=assets
VECTOR_DB_DIR=python/chroma_db
RAG_SCORE_THRESHOLD=0.7
RAG_TOP_K=5
INTENT_CONFIDENCE_THRESHOLD=0.6

# Python service
PYTHON_SERVICE_HOST=0.0.0.0
PYTHON_SERVICE_PORT=8000

# Java skill service
JAVA_SKILL_BASE_URL=http://192.168.1.20:8080/internal/skills
INTERNAL_SKILL_API_KEY=replace-with-a-random-shared-secret
INTERNAL_SKILL_API_KEY_HEADER=X-Internal-Api-Key
JAVA_SKILL_TIMEOUT_SECONDS=120
JAVA_SKILL_CONNECT_TIMEOUT_SECONDS=2

# External search
SERPER_API_KEY1=replace-with-your-serper-api-key

# Vector-store build
BUILD_DOCUMENTS_DIR=assets
BUILD_VECTOR_DB_DIR=python/chroma_db
DOCUMENT_CHUNK_SIZE=500
DOCUMENT_CHUNK_OVERLAP=50
HTTP_PROXY=
HTTPS_PROXY=

# Evaluation
RAG_EVAL_SERVICE_URL=http://127.0.0.1:8000/rag/eval_query
RAG_EVAL_FILE=python/eval/eval_question_diff1.json
RAG_EVAL_REQUEST_TIMEOUT_SECONDS=300
INTENT_EVAL_FILE=python/intent/intent_eval.json
