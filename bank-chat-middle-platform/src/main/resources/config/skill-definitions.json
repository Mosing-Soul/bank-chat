{
  "version": "1.0",
  "skills": [
    {
      "id": "CUSTOMER_AUM",
      "name": "客户资产查询",
      "description": "查询指定客户的AUM、资产和持仓汇总。",
      "enabled": true,
      "riskLevel": "READ_ONLY",
      "interruptPolicy": "SUSPENDABLE",
      "confirmationRequired": false,
      "executor": "customerAumExecutor",
      "domains": ["customer", "wealth-management"],
      "slots": [
        {
          "id": "customerReference",
          "type": "customer_reference",
          "required": true,
          "sensitive": true,
          "shareable": true,
          "validationPolicy": "existing_customer",
          "prompts": ["请提供客户姓名或客户编号。"]
        }
      ],
      "flow": {
        "id": "CUSTOMER_AUM_FLOW",
        "initialStage": "COLLECTING_SLOTS",
        "stages": [
          {"id": "COLLECTING_SLOTS", "type": "COLLECT", "requiredSlots": ["customerReference"], "terminal": false},
          {"id": "VALIDATING", "type": "VALIDATE", "requiredSlots": [], "terminal": false},
          {"id": "EXECUTING", "type": "EXECUTE", "requiredSlots": [], "terminal": false},
          {"id": "COMPLETED", "type": "COMPLETE", "requiredSlots": [], "terminal": true},
          {"id": "CANCELLED", "type": "CANCEL", "requiredSlots": [], "terminal": true}
        ]
      }
    },
    {
      "id": "GOLD_PRICE",
