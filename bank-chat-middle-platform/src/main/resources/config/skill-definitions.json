      "confirmationRequired": false,
      "executor": "goldPriceExecutor",
      "domains": ["market", "precious-metal"],
      "slots": [
        {
          "id": "query",
          "type": "text",
          "required": true,
          "sensitive": false,
          "shareable": false,
          "validationPolicy": "non_blank",
          "prompts": ["请说明需要查询的黄金品种或行情问题。"]
        },
        {
          "id": "marketSymbol",
          "type": "market_symbol",
          "required": false,
          "sensitive": false,
          "shareable": true,
          "validationPolicy": "supported_market_symbol",
          "prompts": []
        }
      ],
      "flow": {
        "id": "GOLD_PRICE_FLOW",
        "initialStage": "COLLECTING_SLOTS",
        "stages": [
          {"id": "COLLECTING_SLOTS", "type": "COLLECT", "requiredSlots": ["query"], "terminal": false},
          {"id": "EXECUTING", "type": "EXECUTE", "requiredSlots": [], "terminal": false},
          {"id": "COMPLETED", "type": "COMPLETE", "requiredSlots": [], "terminal": true},
          {"id": "CANCELLED", "type": "CANCEL", "requiredSlots": [], "terminal": true}
        ]
      }
    },
    {
      "id": "RAG_QUERY",
      "name": "行内知识问答",
      "description": "查询行内制度、产品规则、客户等级规则和监管材料。",
      "enabled": true,
      "riskLevel": "READ_ONLY",
      "interruptPolicy": "REPLACEABLE",
      "confirmationRequired": false,
      "executor": "ragQueryExecutor",
      "domains": ["knowledge", "policy", "product"],
      "slots": [
        {
          "id": "question",
          "type": "text",
          "required": true,
          "sensitive": false,
          "shareable": false,
          "validationPolicy": "non_blank",
          "prompts": ["请说明需要查询的规则、制度或产品问题。"]
        }
      ],
      "flow": {
        "id": "RAG_QUERY_FLOW",
        "initialStage": "COLLECTING_SLOTS",
        "stages": [
          {"id": "COLLECTING_SLOTS", "type": "COLLECT", "requiredSlots": ["question"], "terminal": false},
          {"id": "EXECUTING", "type": "EXECUTE", "requiredSlots": [], "terminal": false},
          {"id": "COMPLETED", "type": "COMPLETE", "requiredSlots": [], "terminal": true},
          {"id": "CANCELLED", "type": "CANCEL", "requiredSlots": [], "terminal": true}
        ]
      }
    },
    {
      "id": "MESSAGE_SEND",
      "name": "客户消息触达",
      "description": "生成客户消息，并在明确确认后执行模拟发送。",
      "enabled": true,
      "riskLevel": "EXTERNAL_SIDE_EFFECT",
      "interruptPolicy": "CONFIRM_OR_SUSPEND",
      "confirmationRequired": true,
      "executor": "messageSendExecutor",
      "domains": ["customer", "message", "outreach"],
      "slots": [
        {
          "id": "customerReference",
          "type": "customer_reference",
          "required": true,
          "sensitive": true,
          "shareable": true,
          "validationPolicy": "existing_customer",
          "prompts": ["请提供需要触达的客户姓名或客户编号。"]
        },
        {
          "id": "messagePurpose",
          "type": "text",
          "required": true,
          "sensitive": false,
          "shareable": false,
          "validationPolicy": "supported_template_or_custom_content",
