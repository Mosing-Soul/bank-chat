        {
          "id": "messageContent",
          "type": "text",
          "required": false,
          "sensitive": true,
          "shareable": false,
          "validationPolicy": "message_content_policy",
          "prompts": []
        }
      ],
      "flow": {
        "id": "MESSAGE_SEND_FLOW",
        "initialStage": "COLLECTING_SLOTS",
        "stages": [
          {"id": "COLLECTING_SLOTS", "type": "COLLECT", "requiredSlots": ["customerReference", "messagePurpose"], "terminal": false},
          {"id": "VALIDATING", "type": "VALIDATE", "requiredSlots": [], "terminal": false},
          {"id": "WAITING_CONFIRMATION", "type": "CONFIRM", "requiredSlots": [], "terminal": false},
          {"id": "EXECUTING", "type": "EXECUTE", "requiredSlots": [], "terminal": false},
          {"id": "COMPLETED", "type": "COMPLETE", "requiredSlots": [], "terminal": true},
          {"id": "CANCELLED", "type": "CANCEL", "requiredSlots": [], "terminal": true}
        ]
      }
    }
  ]
